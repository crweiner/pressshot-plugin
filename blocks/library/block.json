{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pressshot/library",
	"title": "PressShot Library",
	"category": "widgets",
	"description": "The PressShot Library. Signed-in people who can upload see their team's shots here.",
	"textdomain": "pressshot",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"appLayout": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"align": [ "full" ],
		"html": false,
		"inserter": true,
		"multiple": false
	},
	"editorScript": "file:../../build/library-editor.js",
	"render": "file:./render.php",
	"viewScript": "file:../../build/library.js",
	"viewStyle": [ "wp-components", "file:../../build/style-library.css" ]
}
